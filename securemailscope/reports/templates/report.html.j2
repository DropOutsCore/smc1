<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureMailScope Forensic Report — {{ report.report_id[:8] }}</title>
<style>
  :root {
    --bg: #0d1117; --surface: #161b22; --surface2: #21262d;
    --border: #30363d; --text: #e6edf3; --muted: #8b949e;
    --accent: #58a6ff; --critical: #f85149; --high: #d29922;
    --medium: #388bfd; --low: #3fb950; --info: #6e7681;
    --grade-a: #3fb950; --grade-b: #58a6ff; --grade-c: #d29922;
    --grade-d: #f0883e; --grade-f: #f85149;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; font-size: 14px; line-height: 1.6; }
  .container { max-width: 1200px; margin: 0 auto; padding: 32px 24px; }

  /* Header */
  .report-header { border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 32px; }
  .report-header h1 { font-size: 28px; font-weight: 700; color: var(--accent); }
  .report-header .subtitle { color: var(--muted); margin-top: 4px; }
  .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 20px; }
  .meta-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; }
  .meta-card .label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .meta-card .value { font-family: 'Consolas', monospace; font-size: 13px; word-break: break-all; margin-top: 4px; }

  /* Executive Summary */
  .section { margin-bottom: 40px; }
  .section-title { font-size: 18px; font-weight: 600; border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 20px; }

  /* Host cards */
  .host-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .host-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; position: relative; }
  .host-card .grade-badge {
    position: absolute; top: 20px; right: 20px;
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; font-weight: 800;
  }
  .grade-A-plus, .grade-A\+ { background: rgba(63,185,80,0.22); color: #3fb950; border: 2px solid #3fb950; box-shadow: 0 0 10px rgba(63,185,80,0.3); }
  .grade-A { background: rgba(63,185,80,0.15); color: var(--grade-a); border: 2px solid var(--grade-a); }
  .grade-B { background: rgba(88,166,255,0.15); color: var(--grade-b); border: 2px solid var(--grade-b); }
  .grade-C { background: rgba(210,153,34,0.15); color: var(--grade-c); border: 2px solid var(--grade-c); }
  .grade-D { background: rgba(240,136,62,0.15); color: var(--grade-d); border: 2px solid var(--grade-d); }
  .grade-E { background: rgba(248,113,113,0.15); color: #f87171; border: 2px solid #f87171; }
  .grade-F { background: rgba(248,81,73,0.15); color: var(--grade-f); border: 2px solid var(--grade-f); }
  .host-card h3 { font-size: 15px; font-weight: 600; padding-right: 70px; word-break: break-all; }
  .host-card .delta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .severity-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .pill { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; }
  .pill-critical { background: rgba(248,81,73,0.15); color: var(--critical); }
  .pill-high { background: rgba(210,153,34,0.15); color: var(--high); }
  .pill-medium { background: rgba(56,139,253,0.15); color: var(--medium); }
  .pill-low { background: rgba(63,185,80,0.15); color: var(--low); }

  /* Session detail */
  .session-detail { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 16px; overflow: hidden; }
  .session-header { padding: 14px 16px; background: var(--surface2); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
  .session-header h4 { font-size: 13px; font-weight: 600; }
  .session-body { padding: 16px; }
  .detail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin-bottom: 16px; }
  .detail-item .dk { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .detail-item .dv { font-family: monospace; font-size: 13px; margin-top: 2px; }

  /* Findings table */
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { background: var(--surface2); padding: 10px 12px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  td { padding: 10px 12px; border-top: 1px solid var(--border); vertical-align: top; }
  tr:hover td { background: rgba(255,255,255,0.02); }
  .sev-critical { color: var(--critical); font-weight: 700; }
  .sev-high { color: var(--high); font-weight: 600; }
  .sev-medium { color: var(--medium); }
  .sev-low { color: var(--low); }
  .code-block { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 12px; font-family: 'Consolas', monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; margin-top: 8px; }
  .tag { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 4px; background: var(--surface2); border: 1px solid var(--border); color: var(--muted); margin: 2px; }
  .badge-pfs-yes { color: var(--low); font-weight: 600; }
  .badge-pfs-no { color: var(--high); font-weight: 600; }

  /* Evidence appendix */
  .evidence-ref { font-family: monospace; font-size: 12px; background: var(--surface2); padding: 4px 8px; border-radius: 4px; display: inline-block; }

  /* TLS visibility warning */
  .visibility-warning { background: rgba(210,153,34,0.08); border: 1px solid rgba(210,153,34,0.3); border-radius: 6px; padding: 10px 14px; font-size: 12px; color: var(--high); margin-bottom: 12px; }

  /* Footer */
  .report-footer { border-top: 1px solid var(--border); margin-top: 40px; padding-top: 20px; text-align: center; color: var(--muted); font-size: 12px; }
  .sha256 { font-family: monospace; font-size: 11px; word-break: break-all; }

  @media print {
    body { background: #fff; color: #000; }
    .host-card, .session-detail { break-inside: avoid; }
  }
</style>
</head>
<body>
<div class="container">

  <!-- HEADER -->
  <div class="report-header">
    <h1>🔒 SecureMailScope Forensic Report</h1>
    <p class="subtitle">Passive Email TLS/STARTTLS Cryptographic Risk Assessment</p>
    <div class="meta-grid">
      <div class="meta-card">
        <div class="label">Report ID</div>
        <div class="value">{{ report.report_id }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Generated At</div>
        <div class="value">{{ report.generated_at }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Source PCAP SHA-256</div>
        <div class="value">{{ report.source_pcap_sha256 }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Source File</div>
        <div class="value">{{ report.source_pcap_path }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Hosts Analyzed</div>
        <div class="value">{{ report.hosts | length }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Tool Version</div>
        <div class="value">SecureMailScope v{{ report.tool_version }}</div>
      </div>
    </div>
  </div>

  <!-- TLS 1.3 VISIBILITY NOTE -->
  <div class="visibility-warning">
    ⚠️ <strong>TLS 1.3 Visibility Limitation:</strong> {{ report.tls13_visibility_note }}
  </div>

  <!-- EXECUTIVE SUMMARY -->
  <div class="section">
    <div class="section-title">Executive Summary — Host Posture Grades</div>
    <div class="host-grid">
      {% for host in report.hosts %}
      <div class="host-card">
        <div class="grade-badge grade-{{ host.posture_grade | replace('+', '-plus') }}">{{ host.posture_grade }}</div>
        <h3>{{ host.host }}</h3>
        <div style="margin-top:4px;">
          <span style="font-size:12px;font-weight:700;color:{% if host.posture_grade in ['A+', 'A'] %}#3fb950{% elif host.posture_grade == 'B' %}#58a6ff{% elif host.posture_grade == 'C' %}#d29922{% else %}#f85149{% endif %};">
            Security Posture: {{ host.posture_grade }} ({{ host.posture_label or 'Strong' }})
          </span>
        </div>
        {% if host.grade_delta %}
        <div class="delta">📈 {{ host.grade_delta }}</div>
        {% endif %}
        <div class="delta">Risk Score: {{ host.posture_score }} / 100 | Sessions: {{ host.sessions | length }}</div>
        <div class="severity-pills" style="margin-top:10px;">
          {% if host.finding_summary.get('critical', 0) > 0 %}
          <span class="pill pill-critical">{{ host.finding_summary.critical }} Critical</span>
          {% endif %}
          {% if host.finding_summary.get('high', 0) > 0 %}
          <span class="pill pill-high">{{ host.finding_summary.high }} High</span>
          {% endif %}
          {% if host.finding_summary.get('medium', 0) > 0 %}
          <span class="pill pill-medium">{{ host.finding_summary.medium }} Medium</span>
          {% endif %}
          {% if host.finding_summary.get('low', 0) > 0 %}
          <span class="pill pill-low">{{ host.finding_summary.low }} Low</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- PER-HOST DETAIL -->
  {% for host in report.hosts %}
  <div class="section">
    <div class="section-title">
      Host: {{ host.host }}
      <span class="grade-badge grade-{{ host.posture_grade | replace('+', '-plus') }}" style="display:inline-flex;width:36px;height:36px;font-size:16px;vertical-align:middle;margin-left:12px;">{{ host.posture_grade }}</span>
      <span style="font-size:13px;font-weight:600;margin-left:8px;color:var(--muted);">Security Posture: <strong>{{ host.posture_grade }} ({{ host.posture_label or 'Strong' }})</strong> — Risk Score: {{ host.posture_score }}/100</span>
    </div>

    <!-- Why This Grade? — Single Intuitive Posture Grade Breakdown -->
    {% set wg = host.why_this_grade %}
    {% if wg %}
    <div style="margin-bottom:18px;background:rgba(88,166,255,0.04);border:1px solid rgba(88,166,255,0.25);border-radius:8px;padding:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div>
          <span style="font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:0.05em;">🛡️ Why This Grade? — Single Intuitive Security Posture</span>
          <h3 style="margin:2px 0 0 0;font-size:15px;color:#f0f6fc;">
            Security Posture: <strong style="color:{% if host.posture_grade in ['A+', 'A'] %}#3fb950{% elif host.posture_grade == 'B' %}#58a6ff{% elif host.posture_grade == 'C' %}#d29922{% else %}#f85149{% endif %};">{{ host.posture_grade }}</strong> ({{ host.posture_label or wg.label }})
            <span style="font-size:12px;color:var(--muted);font-weight:400;margin-left:8px;">Risk Score: {{ host.posture_score }}/100 (Bracket: {{ wg.threshold_bracket }})</span>
          </h3>
        </div>
        <span class="tag" style="background:#0d1117;color:var(--accent);border-color:var(--accent);font-weight:700;">
          {{ wg.label | upper }}
        </span>
      </div>

      <p style="font-size:12px;color:#c9d1d9;margin:6px 0 12px 0;line-height:1.5;">{{ wg.summary }}</p>

      <!-- Grade Ladder Bar -->
      {% if wg.grade_ladder %}
      <div style="display:flex;gap:6px;margin-bottom:12px;overflow-x:auto;">
        {% for step in wg.grade_ladder %}
        <div style="flex:1;min-width:65px;padding:6px 4px;text-align:center;border-radius:6px;border:1px solid {% if step.active %}#3fb950{% else %}rgba(255,255,255,0.08){% endif %};background:{% if step.active %}rgba(63,185,80,0.15){% else %}rgba(0,0,0,0.2){% endif %};">
          <div style="font-size:13px;font-weight:700;color:{% if step.active %}#3fb950{% else %}#8b949e{% endif %};">{{ step.grade }}</div>
          <div style="font-size:9px;color:{% if step.active %}#e6edf3{% else %}#6e7681{% endif %};">{{ step.label }}</div>
          <div style="font-size:8px;font-family:monospace;color:#6e7681;">{{ step.range }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Determining Factors Table -->
      {% if wg.determining_factors %}
      <div style="margin-top:10px;">
        <span style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;">Findings Causing This Grade (Deterministic Impact):</span>
        <table style="margin-top:6px;">
          <thead>
            <tr>
              <th>Finding / Rule</th>
              <th>Observed on Wire</th>
              <th>Score Impact</th>
              <th>Severity</th>
              <th>Packet Evidence</th>
              <th>Impact on Posture Grade</th>
            </tr>
          </thead>
          <tbody>
            {% for f in wg.determining_factors %}
            <tr>
              <td><strong>{{ f.feature }}</strong><br/><span style="font-size:10px;color:var(--muted)">{{ f.rule_id }}</span></td>
              <td><code>{{ f.observed_value }}</code></td>
              <td style="color:var(--critical);font-weight:700;">+{{ f.score_contribution }}</td>
              <td class="sev-{{ f.severity }}">{{ f.severity | upper }}</td>
              <td><span class="evidence-ref">{{ f.evidence_ref }}</span></td>
              <td style="font-size:11px;color:var(--muted)">{{ f.impact_on_grade }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <!-- Actionable Target -->
      {% if wg.next_grade_target %}
      <div style="margin-top:10px;padding:8px 12px;background:rgba(210,153,34,0.08);border:1px solid rgba(210,153,34,0.3);border-radius:6px;display:flex;justify-content:space-between;align-items:center;">
        <span style="font-size:11px;color:#d29922;font-weight:600;">🎯 Path to Grade {{ wg.next_grade_target.target_grade }} ({{ wg.next_grade_target.target_label }}):</span>
        <span style="font-size:11px;color:#e6edf3;">{{ wg.next_grade_target.top_remediation_action }}</span>
      </div>
      {% endif %}
    </div>
    {% endif %}

    <!-- Host Posture Score Breakdown -->
    {% if host.why_this_score %}
    <div style="margin-bottom:18px;background:rgba(139,255,122,0.03);border:1px solid rgba(139,255,122,0.2);border-radius:8px;padding:14px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <strong style="color:var(--accent);font-size:13px;">🔍 Host Posture Score Breakdown — {{ host.host }}</strong>
        <span class="tag" style="background:#0d1117;color:#3fb950;border-color:#3fb950;font-weight:700;">
          Posture Score: {{ host.why_this_score.posture_score }} / 100 (Grade {{ host.why_this_score.posture_grade }})
        </span>
      </div>
      {% if host.why_this_score.ascii_tree %}
      <pre class="code-block" style="background:#0d1117;color:#3fb950;font-size:11px;line-height:1.45;margin:6px 0 0 0;">{{ host.why_this_score.ascii_tree }}</pre>
      {% endif %}
    </div>
    {% endif %}

    {% for session in host.sessions %}
    <div class="session-detail">
      <div class="session-header">
        <h4>
          {{ session.protocol }} Session —
          {{ session.src_ip }}:{{ session.src_port }} → {{ session.dst_ip }}:{{ session.dst_port }}
          {% if session.starttls_detected %}<span class="tag">STARTTLS</span>{% endif %}
          {% if session.is_implicit_tls %}<span class="tag">Implicit TLS</span>{% endif %}
          {% if session.downgrade_suspected %}<span class="tag" style="color:var(--critical)">⚠ DOWNGRADE</span>{% endif %}
        </h4>
        <span style="color:var(--muted);font-size:12px;">{{ session.session_id[:8] }}…</span>
      </div>
      <div class="session-body">

        {% if session.tls13_visibility_limited %}
        <div class="visibility-warning">🔒 TLS 1.3 — some handshake fields are not visible in this passive capture.</div>
        {% endif %}

        <!-- TLS Details -->
        <div class="detail-grid">
          <div class="detail-item"><div class="dk">TLS Version</div><div class="dv">{{ session.tls_version }}</div></div>
          <div class="detail-item"><div class="dk">Cipher Suite</div><div class="dv">{{ session.cipher_suite }}</div></div>
          <div class="detail-item"><div class="dk">Cipher Strength</div><div class="dv">{{ session.cipher_strength }}</div></div>
          <div class="detail-item"><div class="dk">Key Exchange</div><div class="dv">{{ session.key_exchange }}</div></div>
          <div class="detail-item">
            <div class="dk">PFS</div>
            <div class="dv {% if session.pfs %}badge-pfs-yes{% else %}badge-pfs-no{% endif %}">
              {% if session.pfs %}✅ Yes{% else %}❌ No{% endif %}
            </div>
          </div>
          <div class="detail-item"><div class="dk">SNI</div><div class="dv">{{ session.sni or '—' }}</div></div>
          <div class="detail-item"><div class="dk">ML Risk</div><div class="dv">{{ session.ml_risk_label }} ({{ "%.0f"|format(session.ml_confidence * 100) }}%)</div></div>
          <div class="detail-item">
            <div class="dk">Anomaly</div>
            <div class="dv">{% if session.anomaly_detected %}⚠️ Detected ({{ "%.3f"|format(session.anomaly_score) }}){% else %}Normal{% endif %}</div>
          </div>
        </div>

        <!-- Certificate -->
        {% if session.certificate %}
        <div style="margin-top:12px;">
          <strong>Certificate</strong>
          <div class="detail-grid" style="margin-top:8px;">
            <div class="detail-item"><div class="dk">Subject</div><div class="dv">{{ session.certificate.subject }}</div></div>
            <div class="detail-item"><div class="dk">Issuer</div><div class="dv">{{ session.certificate.issuer }}</div></div>
            <div class="detail-item"><div class="dk">Key</div><div class="dv">{{ session.certificate.key_algorithm }} {{ session.certificate.key_length }} bit ({{ session.certificate.key_strength }})</div></div>
            <div class="detail-item"><div class="dk">Signature Alg</div><div class="dv">{{ session.certificate.signature_algorithm }}</div></div>
            <div class="detail-item"><div class="dk">Expires</div><div class="dv {% if session.certificate.is_expired %}sev-critical{% elif session.certificate.expiring_within_30_days %}sev-high{% endif %}">
              {{ session.certificate.expires or '—' }}
              {% if session.certificate.is_expired %} ⛔ EXPIRED{% elif session.certificate.expiring_within_30_days %} ⚠️ EXPIRING SOON{% endif %}
            </div></div>
            <div class="detail-item"><div class="dk">Self-signed</div><div class="dv">{% if session.certificate.is_self_signed %}⚠️ Yes{% else %}No{% endif %}</div></div>
            <div class="detail-item"><div class="dk">Hostname Match</div><div class="dv">
              {% if session.certificate.hostname_match == true %}✅ Yes
              {% elif session.certificate.hostname_match == false %}❌ No (Mismatch)
              {% else %}—{% endif %}
            </div></div>
            {% if session.certificate.sans %}
            <div class="detail-item" style="grid-column: 1/-1;"><div class="dk">SANs</div><div class="dv">{{ session.certificate.sans | join(', ') }}</div></div>
            {% endif %}
          </div>
        </div>
        {% endif %}

        <!-- WHY THIS SCORE? (EXPLAINABLE AI & RISK BREAKDOWN) -->
        {% if session.why_this_score %}
        <div style="margin-top:16px;background:rgba(139,255,122,0.03);border:1px solid rgba(139,255,122,0.2);border-radius:8px;padding:14px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <strong style="color:var(--accent);font-size:13px;">🔍 Why This Score? — Transparent Risk Reasoning</strong>
            <span class="tag" style="background:#0d1117;color:#3fb950;border-color:#3fb950;font-weight:700;">
              Score: {{ session.why_this_score.risk_score }} / 100 ({{ session.why_this_score.severity | upper }})
            </span>
          </div>

          <!-- ASCII Decision Tree -->
          {% if session.why_this_score.ascii_tree %}
          <pre class="code-block" style="background:#0d1117;color:#3fb950;font-size:11px;line-height:1.45;margin:8px 0 12px 0;">{{ session.why_this_score.ascii_tree }}</pre>
          {% endif %}

          <!-- Factor breakdown table -->
          {% if session.why_this_score.contributing_factors %}
          <table>
            <thead>
              <tr>
                <th>Finding / Feature</th>
                <th>Observed on Wire</th>
                <th>Score Impact</th>
                <th>Severity</th>
                <th>Evidence Reference</th>
                <th>Reason & Rationale</th>
              </tr>
            </thead>
            <tbody>
              {% for f in session.why_this_score.contributing_factors %}
              <tr>
                <td><strong>{{ f.feature }}</strong><br/><span style="font-size:10px;color:var(--muted)">{{ f.rule_id }}</span></td>
                <td><code style="color:var(--high)">{{ f.observed_value }}</code></td>
                <td style="color:var(--critical);font-weight:700;">+{{ f.score_contribution }}</td>
                <td class="sev-{{ f.severity }}">{{ f.severity | upper }}</td>
                <td><span class="evidence-ref">{{ f.evidence_reference }}</span></td>
                <td style="font-size:12px;color:var(--muted)">{{ f.short_explanation }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% else %}
          <p style="color:var(--low);font-size:12px;margin:4px 0;">✓ Clean baseline: no adverse risk factors or security vulnerabilities detected.</p>
          {% endif %}

          <!-- Separated ML Anomaly Assessment -->
          {% set ml = session.ml_anomaly_assessment or session.why_this_score.ml_anomaly_assessment %}
          {% if ml %}
          <div style="margin-top:12px;padding:10px 12px;background:rgba(88,166,255,0.06);border:1px solid rgba(88,166,255,0.2);border-radius:6px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
              <span style="font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase;">🤖 ML Anomaly Assessment (Independent Statistical Model)</span>
              <span class="tag" style="color:var(--accent);border-color:var(--accent);">{{ ml.ml_risk_label | upper }} ({{ "%.0f"|format(ml.ml_confidence * 100) }}% conf)</span>
            </div>
            <p style="font-size:11px;color:var(--muted);margin-bottom:6px;">{{ ml.score_isolation_note }}</p>
            <div style="display:flex;gap:12px;font-size:11px;font-family:monospace;flex-wrap:wrap;">
              <span>Anomaly Detected: <strong style="color:{% if ml.is_model_anomaly %}var(--critical){% else %}var(--low){% endif %}">{% if ml.is_model_anomaly %}YES{% else %}NO{% endif %}</strong></span>
              <span>Anomaly Score: <strong>{{ "%.3f"|format(ml.anomaly_score) }}</strong></span>
              <span>Architecture: <strong>{{ ml.model_architecture }}</strong></span>
            </div>
          </div>
          {% endif %}
        </div>
        {% endif %}

        <!-- Findings -->
        {% if session.findings %}
        <div style="margin-top:16px;">
          <strong>Findings ({{ session.findings | length }})</strong>
          <table style="margin-top:8px;">
            <tr>
              <th>Severity</th><th>ID</th><th>Description</th><th>Evidence</th><th>CWE</th>
            </tr>
            {% for f in session.findings %}
            <tr>
              <td class="sev-{{ f.severity }}">{{ f.severity | upper }}</td>
              <td><code>{{ f.id }}</code></td>
              <td>
                {{ f.description }}
                {% if f.contributing_factors %}
                <div style="margin-top:6px;">
                  {% for cf in f.contributing_factors %}
                  <span class="tag">{{ cf }}</span>
                  {% endfor %}
                </div>
                {% endif %}
                {% if f.remediation %}
                <div class="code-block">{{ f.remediation }}</div>
                {% endif %}
              </td>
              <td><span class="evidence-ref">pkt #{{ f.evidence_ref.get('packet_number', '?') }}</span></td>
              <td><span class="tag">{{ f.cwe or '—' }}</span></td>
            </tr>
            {% endfor %}
          </table>
        </div>
        {% endif %}

      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <!-- FORENSIC EVIDENCE & CHAIN OF CUSTODY -->
  <div class="section" id="forensic-evidence">
    <div class="section-title">Forensic Evidence & Chain of Custody</div>

    <!-- Integrity Statement Banner -->
    <div style="background: rgba(63, 185, 80, 0.1); border: 1px solid #3fb950; border-radius: 8px; padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <span style="color: #3fb950; font-weight: 700; font-size: 14px;">🛡️ INTEGRITY STATEMENT:</span>
        <span style="color: #e6edf3; font-weight: 600; font-size: 13px; margin-left: 8px;">No active network connections were made during analysis.</span>
      </div>
      <span style="background: rgba(63, 185, 80, 0.2); color: #3fb950; border: 1px solid #3fb950; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 999px;">
        {{ report.forensic_evidence_and_chain_of_custody.passive_offline_status if report.forensic_evidence_and_chain_of_custody else 'PASSIVE / OFFLINE (AIR-GAPPED)' }}
      </span>
    </div>

    <!-- Metadata Grid -->
    <div class="meta-grid" style="margin-bottom: 24px;">
      <div class="meta-card">
        <div class="label">Source PCAP</div>
        <div class="value">{{ report.source_pcap_path or (report.forensic_evidence_and_chain_of_custody.source_pcap if report.forensic_evidence_and_chain_of_custody else 'N/A') }}</div>
      </div>
      <div class="meta-card">
        <div class="label">PCAP SHA-256</div>
        <div class="value sha256">{{ report.source_pcap_sha256 }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Analysis ID</div>
        <div class="value">{{ report.analysis_id or (report.forensic_evidence_and_chain_of_custody.analysis_id if report.forensic_evidence_and_chain_of_custody else report.report_id) }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Report ID</div>
        <div class="value">{{ report.report_id }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Timestamp</div>
        <div class="value">{{ report.generated_at }}</div>
      </div>
      <div class="meta-card">
        <div class="label">Analyzer Version</div>
        <div class="value">SecureMailScope v{{ report.tool_version }}</div>
      </div>
    </div>

    <!-- Packet-level Evidence Mapping -->
    <h3 style="font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 8px;">Packet-Level Evidence Mapping</h3>
    <p style="color: var(--muted); font-size: 12px; margin-bottom: 14px;">
      Provenance chain: <code>PCAP SHA-256 → Session → Packet Number/Offset → Observed Value → Finding ID → Detection Rule</code>
    </p>

    <table>
      <thead>
        <tr>
          <th>Finding ID</th>
          <th>Detection Rule</th>
          <th>Session Flow</th>
          <th>Packet # / Offset</th>
          <th>Observed Wire Value</th>
          <th>Evidence Reference Chain</th>
        </tr>
      </thead>
      <tbody>
        {% set evidence_list = report.forensic_evidence_and_chain_of_custody.packet_level_evidence_mapping if report.forensic_evidence_and_chain_of_custody else [] %}
        {% if evidence_list %}
          {% for ev in evidence_list %}
          <tr>
            <td><code>{{ ev.finding_id[:8] if ev.finding_id|length > 8 else ev.finding_id }}</code></td>
            <td><strong>{{ ev.detection_rule }}</strong></td>
            <td><code>{{ ev.session_flow }}</code></td>
            <td><span class="evidence-ref">Pkt #{{ ev.packet_number }} (Offset {{ ev.byte_offset }})</span></td>
            <td><code>{{ ev.observed_value }}</code></td>
            <td style="font-size: 11px; font-family: monospace; color: var(--muted); word-break: break-all;">{{ ev.evidence_chain }}</td>
          </tr>
          {% endfor %}
        {% else %}
          {% for host in report.hosts %}
            {% for session in host.sessions %}
              {% for f in session.findings %}
              {% set ev = f.evidence_reference if f.evidence_reference else {} %}
              <tr>
                <td><code>{{ f.id }}</code></td>
                <td><strong>{{ f.id }}</strong></td>
                <td><code>{{ session.protocol }} {{ session.src_ip }}:{{ session.src_port }} → {{ session.dst_ip }}:{{ session.dst_port }}</code></td>
                <td><span class="evidence-ref">Pkt #{{ f.evidence_ref.get('packet_number', '?') }} (Offset {{ f.evidence_ref.get('byte_offset', 0) }})</span></td>
                <td><code>{{ ev.observed_value if ev.observed_value else f.description }}</code></td>
                <td style="font-size: 11px; font-family: monospace; color: var(--muted);">{{ ev.evidence_chain if ev.evidence_chain else (report.source_pcap_sha256[:12] ~ '… → ' ~ session.session_id[:8] ~ ' → Pkt #' ~ f.evidence_ref.get('packet_number', '?') ~ ' → ' ~ f.id) }}</td>
              </tr>
              {% endfor %}
            {% endfor %}
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>

  <!-- FOOTER -->
  <div class="report-footer">
    <p>SecureMailScope v{{ report.tool_version }} — Passive Forensic Analysis — No active network connections were made.</p>
    <p class="sha256">Source PCAP: {{ report.source_pcap_sha256 }} | Report ID: {{ report.report_id }}</p>
  </div>

</div>
</body>
</html>
